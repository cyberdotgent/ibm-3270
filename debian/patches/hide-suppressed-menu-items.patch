+/*
+ * The actions each File menu item runs, separated by spaces. An item is left
+ * out of the menu if any of them is suppressed (the suppressActions resource).
+ */
+static const char *file_menu_action_names[FM_COUNT] = {
+    AnEscape " " AnShow,	/* Copyright */
+    AnEscape " " AnShow,	/* Status */
+    AnEscape " " AnShow,	/* About */
+    AnEscape,			/* Prompt */
+    AnPrintText,		/* Print Screen */
+    AnEscape " " AnTransfer,	/* File Transfer */
+    AnTrace,			/* Tracing */
+    AnScreenTrace,		/* Save Screen Images in File */
+    AnScreenTrace,		/* Save Screen Images to Printer */
+    AnSaveInput,		/* Save Input Fields */
+    AnRestoreInput,		/* Restore Input Fields */
+    AnEscape " " AnShow,	/* Display Keymap */
+#if defined(HAVE_START) /*[*/
+    NULL,			/* Help */
+#endif /*]*/
+#if defined(_WIN32) /*[*/
+    NULL,			/* Session Wizard */
+    NULL,			/* Edit Session */
+#endif /*]*/
+    AnKeyboardDisable,		/* Re-enable Keyboard */
+    AnDisconnect,		/* Disconnect */
+    AnQuit			/* Quit */
+};
+
+/* Returns true if any of a space-separated list of actions is suppressed. */
+static bool
+any_action_suppressed(const char *names)
+{
+    char *list;
+    char *name;
+    bool suppressed = false;
+
+    if (names == NULL) {
+	return false;
+    }
+    list = NewString(names);
+    for (name = strtok(list, " "); name != NULL; name = strtok(NULL, " ")) {
+	if (action_suppressed(name)) {
+	    suppressed = true;
+	    break;
+	}
+    }
+    Free(list);
+    return suppressed;
+}
